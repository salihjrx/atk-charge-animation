# Windows araci: metin dosyalari indirildiginde (git clone / ZIP) CRLF satir sonuyla gelsin
* text=auto
*.ps1  text eol=crlf
*.cs   text eol=crlf
*.xaml text eol=crlf
*.json text eol=crlf
*.csv  text eol=crlf
*.txt  text eol=crlf
*.png  binary
*.gif  binary
*.ico  binary
*.exe  binary

# "Code -> Download ZIP" paketine girmesin: kullanici klasorde yalnizca uygulamayi gorsun.
# (Bunlar GitHub sayfasinda kalir; lisansin kopyasi app\LICENSE.txt olarak pakettedir.)
.gitattributes export-ignore
.gitignore     export-ignore
README.md      export-ignore
LICENSE        export-ignore
app/docs       export-ignore
app/tests      export-ignore
app/tools      export-ignore
