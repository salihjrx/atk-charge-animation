<!-- Sag alt bildirim balonu: dusuk pil (kirmizi) ve sarj doldu (tema rengi).
     {{BG1}} {{BG2}} {{BORDER}}: koddan doldurulan renkler (RRGGBB) -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="392" Height="136" WindowStartupLocation="Manual">

  <!-- Kenar boslugu golge icin; kayma (ToastSlide) koddan -->
  <Grid x:Name="ToastRoot" Margin="16" Opacity="0">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="ToastSlide" X="392"/>
    </Grid.RenderTransform>

    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#73{{BORDER}}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F5{{BG1}}" Offset="0"/>
          <GradientStop Color="#F5{{BG2}}" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.55"/>
      </Border.Effect>

      <Grid>
        <Grid Margin="16,12,18,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Width="46" Height="46" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Ellipse Fill="#2EFFFFFF"/>
            <Ellipse x:Name="IconPulse" Stroke="#B3FFFFFF" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
              <Ellipse.RenderTransform><ScaleTransform x:Name="IconPulseScale"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- dusuk pil: yanip sonen bos pil -->
            <Canvas x:Name="IconLow" Width="26" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="23" Height="14" CornerRadius="3.5" BorderBrush="White" BorderThickness="2"/>
              <Border Canvas.Left="23.5" Canvas.Top="4.5" Width="2.5" Height="5" CornerRadius="0,1.5,1.5,0" Background="White"/>
              <Border x:Name="IconFill" Canvas.Left="3.5" Canvas.Top="3.5" Width="4.5" Height="7" CornerRadius="1.5" Background="White"/>
            </Canvas>

            <!-- sarj doldu: dolu pil + onay isareti -->
            <Canvas x:Name="IconFull" Width="26" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <Border Width="23" Height="14" CornerRadius="3.5" BorderBrush="White" BorderThickness="2"/>
              <Border Canvas.Left="23.5" Canvas.Top="4.5" Width="2.5" Height="5" CornerRadius="0,1.5,1.5,0" Background="White"/>
              <Border Canvas.Left="3.5" Canvas.Top="3.5" Width="16" Height="7" CornerRadius="1.5" Background="#E6FFFFFF"/>
              <Path Canvas.Left="6" Canvas.Top="2" Data="M0,5 L4,9 L11,1" Stroke="#{{BG2}}" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
          </Grid>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ToastTitle" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="ToastBody" Text="" FontFamily="Segoe UI" FontSize="13" Foreground="#F0FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ToastDevice" Text="" FontFamily="Segoe UI" FontSize="11" Foreground="#C0FFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>

        <!-- kalan sure cubugu (koddan kuculur) -->
        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#99FFFFFF" VerticalAlignment="Bottom" Margin="18,0,18,7"
                   RenderTransformOrigin="0,0.5">
          <Rectangle.RenderTransform><ScaleTransform x:Name="ToastBarScale"/></Rectangle.RenderTransform>
        </Rectangle>
      </Grid>
    </Border>

    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="IconFill" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="IconPulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.45" Duration="0:0:1.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="IconPulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.45" Duration="0:0:1.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="IconPulse" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.2" RepeatBehavior="Forever"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
  </Grid>
</Window>
