<!-- Ayarlar penceresi. "t:" ile baslayan yer tutucular metinler.json'dan doldurulur. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{{t:settingsTitle}}" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="Muted" Color="#8A97A6"/>
    <SolidColorBrush x:Key="Field" Color="#18202A"/>
    <SolidColorBrush x:Key="FieldHover" Color="#212B37"/>
    <SolidColorBrush x:Key="Line" Color="#26313D"/>
    <!-- vurgu renkleri: tema degisince koddan guncellenir (DynamicResource) -->
    <SolidColorBrush x:Key="Accent" Color="#{{A1}}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#26{{A1}}"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#{{A1}}" Offset="0"/>
      <GradientStop Color="#{{A2}}" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>

    <!-- yuvarlak koseli dugme -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource FieldHover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8A97A6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- tema ornegi dugmesi (icerik koddan) -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Width="112" Padding="6,10" CornerRadius="12" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Field}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8A97A6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- dil secimi: hap seklinde secenekler -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Background="{StaticResource Field}" CornerRadius="10" Padding="14,8"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource FieldHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#2A3441" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#C9D1DA" HorizontalAlignment="Left" Margin="3,0"/>
              </Border>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Fill" Value="#0B0F14"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Hex" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Width" Value="110"/>
      <Setter Property="MaxLength" Value="7"/>
    </Style>
  </Window.Resources>

  <Border Margin="14" CornerRadius="20" BorderThickness="1" BorderBrush="#2A3644">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141B24" Offset="0"/>
        <GradientStop Color="#0B0F14" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/></Border.Effect>

    <StackPanel Margin="26,18,26,22">
      <!-- baslik (surukle-birak ile tasinir) -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal">
          <Grid Width="40" Height="40">
            <Ellipse x:Name="LogoCircle" Fill="{DynamicResource AccentGradient}"/>
            <Path Width="13" Height="21" Stretch="Uniform" Fill="#0B0F14" Data="M14,0 L0,23 L10,23 L6,40 L22,14 L12,14 L18,0 Z"/>
          </Grid>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{{t:settingsTitle}}" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{{t:settingsSubtitle}}" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="CloseButton" Style="{StaticResource Pill}" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Center"
                Content="&#x2715;" ToolTip="Kapat / Close"/>
      </Grid>

      <TextBlock Style="{StaticResource Header}" Text="{{t:themeHeader}}"/>
      <WrapPanel x:Name="ThemePanel"/>

      <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,4,0,0">
        <TextBlock Text="{{t:customHeader}}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Custom1Preview" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0"/>
          <TextBox x:Name="Custom1Box" Style="{StaticResource Hex}" ToolTip="{{t:color1}}"/>
          <Border x:Name="Custom2Preview" Width="30" Height="30" CornerRadius="8" Margin="22,0,8,0"/>
          <TextBox x:Name="Custom2Box" Style="{StaticResource Hex}" ToolTip="{{t:color2}}"/>
        </StackPanel>
      </StackPanel>

      <TextBlock Style="{StaticResource Header}" Text="{{t:notificationsHeader}}"/>
      <CheckBox x:Name="FullNotifyBox" Style="{StaticResource Check}" Content="{{t:optFull}}"/>
      <CheckBox x:Name="LowWarnBox" Style="{StaticResource Check}" Content="{{t:optLow}}"/>
      <CheckBox x:Name="ClickBox" Style="{StaticResource Check}" Content="{{t:optClick}}"/>

      <TextBlock Style="{StaticResource Header}" Text="{{t:languageHeader}}"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="LangAuto" GroupName="Lang" Style="{StaticResource Segment}" Content="{{t:langAuto}}"/>
        <RadioButton x:Name="LangTr" GroupName="Lang" Style="{StaticResource Segment}" Content="T&#xFC;rk&#xE7;e"/>
        <RadioButton x:Name="LangEn" GroupName="Lang" Style="{StaticResource Segment}" Content="English"/>
      </StackPanel>

      <TextBlock Style="{StaticResource Header}" Text="{{t:tryHeader}}"/>
      <WrapPanel>
        <Button x:Name="TryCharge" Style="{StaticResource Pill}" Margin="0,0,8,8" Content="{{t:tryCharge}}"/>
        <Button x:Name="TryLow" Style="{StaticResource Pill}" Margin="0,0,8,8" Content="{{t:tryLow}}"/>
        <Button x:Name="TryFull" Style="{StaticResource Pill}" Margin="0,0,8,8" Content="{{t:tryFull}}"/>
      </WrapPanel>

      <TextBlock Text="{{t:autosaveNote}}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</Window>
